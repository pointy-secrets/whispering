{
  "font": {
    "family": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "size_body": "10pt",
    "size_logo": "clamp(36px, 11vw, 100px)",
    "size_filter_menu": "10pt",
    "weight_all": "200"
  },
  "color": {
    "primary": "#00C3E1",
    "background": "#ffffff",
    "opacity_muted": "0.7",
    "drop_zone_hover": "#f0fafc"
  },
  "spacing": {
    "margin_side": "clamp(16px, 5vw, 80px)",
    "margin_top_desktop": "clamp(24px, 4vw, 48px)",
    "margin_bottom": "40px",
    "gap_header_bottom": "clamp(16px, 3vw, 20px)",
    "gap_tracks": "clamp(14px, 2vw, 16px)",
    "top_padding": "clamp(28px, 5vw, 54px)",
    "drop_zone_height": "180px",
    "drop_zone_radius": "8px"
  },
  "media_player": {
    "height": "36px",
    "width_desktop": "100%"
  },
  "header": {
    "logo_weight": "200",
    "logo_style": "italic",
    "logo_line_height": "0.95",
    "logo_max_width": "100%"
  },
  "menu": {
    "top_offset": "32px",
    "border_radius": "8px",
    "item_padding": "6px 10px",
    "item_font_size": "10pt",
    "artist_indent": "28px",
    "max_width": "min(280px, calc(100vw - 32px))"
  },
  "borders": {
    "hairline_color": "rgba(0,195,225,0.25)",
    "hairline_width": "1px"
  },
  "manage_page": {
    "delete_btn_size": "11pt"
  }
}
