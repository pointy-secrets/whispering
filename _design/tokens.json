{
  "color": {
    "primary":   { "$value": "#00C3E1", "$type": "color" },
    "ink":       { "$value": "0,195,225", "$type": "color" },
    "reverse":   { "$value": "255,255,255", "$type": "color" },
    "background": { "$value": "#ffffff", "$type": "color" },
    "panel":     { "$value": "240,250,252", "$type": "color" }
  },
  "font": {
    "family":   { "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif", "$type": "fontFamily" },
    "weight":    { "base": { "$value": 200, "$type": "fontWeight" } },
    "size": {
      "body":    { "$value": "10pt", "$type": "dimension" },
      "meta":    { "$value": "11pt", "$type": "dimension" },
      "display": { "$value": "7.5em", "$type": "dimension" }
    }
  },
  "space": {
    "side":      { "$value": "5px", "$type": "dimension" },
    "side_mobile": { "$value": "16px", "$type": "dimension" },
    "top":       { "$value": "40px", "$type": "dimension" }
  },
  "radius": {
    "pill":   { "$value": "999px", "$type": "dimension" },
    "media":  { "$value": "0", "$type": "dimension" }
  }
}
